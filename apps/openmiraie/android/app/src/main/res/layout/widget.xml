<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" android:textSize="14sp" android:text="@string/app_name" android:drawableEnd="@drawable/ic_external" android:drawablePadding="8dp"/>
<TextView android:id="@+id/widget_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_badge" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="@color/on_yellow" android:textSize="11sp"/>
<TextView android:id="@+id/widget_target" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" android:textSize="36sp" android:letterSpacing="-0.04" android:maxLines="1"/>
<TextView android:id="@+id/widget_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp"/>
<TextView android:id="@+id/widget_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="11sp"/>
<TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:textColor="@color/muted" android:textSize="11sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/widget_power" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="5dp" android:background="@drawable/widget_action" android:textAllCaps="false" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" android:padding="4dp" android:minWidth="48dp" android:textSize="12sp" android:text="@string/power"/>
<Button android:id="@+id/widget_display" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="5dp" android:background="@drawable/widget_action" android:textAllCaps="false" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" android:padding="4dp" android:minWidth="48dp" android:textSize="12sp" android:text="@string/display"/>
<ImageButton android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_action" android:padding="12dp" android:src="@drawable/ic_refresh" android:contentDescription="@string/refresh"/>
</LinearLayout></LinearLayout>