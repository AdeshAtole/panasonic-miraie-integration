      ]
    },
    {
      "id": "android",
      "path": "apps/openmiraie/android",
      "status": "active",
      "toolchain": "gradle",
      "build": [
        "./gradlew",
        "--no-daemon",
        ":app:assembleDebug"
      ],
      "test": [
        "./gradlew",
        "--no-daemon",
        ":app:testDebugUnitTest"
      ],
      "requiredFiles": [
        "gradlew",
        "gradle/wrapper/gradle-wrapper.jar",
        "gradle/wrapper/gradle-wrapper.properties",
        "settings.gradle.kts",
        "build.gradle.kts",
        "app/build.gradle.kts",
        "app/gradle.lockfile",
        "gradle/verification-metadata.xml",
        "app/src/main/AndroidManifest.xml",
        "app/src/test/java/in/openmiraie/android/ProtocolTest.java"
      ],
      "displayName": "openMirAIe",
      "artifacts": [
        "app/build/outputs/apk/debug/app-debug.apk"
      ]
    },
    {
      "id": "ios",
      "path": "apps/openmiraie/ios",
      "status": "planned",
      "toolchain": "xcode",
      "build": [
        "xcodebuild",
        "-project",
        "OpenMirAIe.xcodeproj",
        "-scheme",
        "OpenMirAIeIOS",
        "-destination",
        "generic/platform=iOS Simulator",
        "-derivedDataPath",
        "build/DerivedData",
        "CODE_SIGNING_ALLOWED=NO",
        "build"
      ],
      "requiredFiles": [
        "OpenMirAIe.xcodeproj/project.pbxproj",
        "OpenMirAIe.xcodeproj/xcshareddata/xcschemes/OpenMirAIeIOS.xcscheme"
      ],
      "reason": "Native iOS Xcode project and shared scheme will be added when development starts.",
      "displayName": "openMirAIe"
    },
    {
      "id": "macos",
      "path": "apps/openmiraie/macos",
      "status": "planned",
      "toolchain": "xcode",
      "build": [
        "xcodebuild",
        "-project",
        "OpenMirAIe.xcodeproj",
        "-scheme",
        "OpenMirAIeMac",
        "-destination",
        "platform=macOS",
        "-derivedDataPath",
        "build/DerivedData",
        "CODE_SIGNING_ALLOWED=NO",
        "build"
      ],
      "requiredFiles": [
        "OpenMirAIe.xcodeproj/project.pbxproj",
        "OpenMirAIe.xcodeproj/xcshareddata/xcschemes/OpenMirAIeMac.xcscheme"
      ],
      "reason": "Native macOS Xcode project and shared scheme will be added when development starts.",
      "displayName": "openMirAIe"
    },
    {
      "id": "miraie-mcp",
      "path": "servers/miraie-mcp",
      "status": "active",
      "toolchain": "python-uv",
      "displayName": "openMirAIe MCP",
      "build": [
        "uv",
        "build",
        "--offline",
        "--no-sources"
      ],
      "test": [
        "uv",
        "run",
        "--frozen",
        "--offline",
        "--no-sync",
        "pytest",
        "-q"
      ],
      "requiredFiles": [
        "pyproject.toml",
        "uv.lock",
        "src/miraie_mcp/server.py",
        "tests/test_protocol.py"
      ],
      "artifacts": [
        "dist/openmiraie_mcp-0.1.0-py3-none-any.whl"
      ]
    }
  ]
}
