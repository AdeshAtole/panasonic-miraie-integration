    {
      "id": "android",
      "path": "apps/openmiraie/android",
      "status": "design",
      "toolchain": "gradle",
      "build": [
        "./gradlew",
        "--no-daemon",
        ":app:assembleDebug"
      ],
      "test": [
        "./gradlew",
        "--no-daemon",
        ":app:testDebugUnitTest"
      ],
      "requiredFiles": [
        "gradlew",
        "gradle/wrapper/gradle-wrapper.jar",
        "gradle/wrapper/gradle-wrapper.properties",
        "settings.gradle.kts"
      ],
      "reason": "Production native Android project is not scaffolded; the current implementation is a separate PoC.",
      "displayName": "openMirAIe"
    },
    {
      "id": "ios",
      "path": "apps/openmiraie/ios",
      "status": "planned",
      "toolchain": "xcode",
      "build": [
        "xcodebuild",
        "-project",
        "OpenMirAIe.xcodeproj",
        "-scheme",
        "OpenMirAIeIOS",
        "-destination",
        "generic/platform=iOS Simulator",
        "-derivedDataPath",
        "build/DerivedData",
        "CODE_SIGNING_ALLOWED=NO",
        "build"
      ],
      "requiredFiles": [
        "OpenMirAIe.xcodeproj/project.pbxproj",
        "OpenMirAIe.xcodeproj/xcshareddata/xcschemes/OpenMirAIeIOS.xcscheme"
      ],
      "reason": "Native iOS Xcode project and shared scheme will be added when development starts.",
      "displayName": "openMirAIe"
    },
    {
      "id": "macos",
      "path": "apps/openmiraie/macos",
      "status": "planned",
      "toolchain": "xcode",
      "build": [
        "xcodebuild",
        "-project",
        "OpenMirAIe.xcodeproj",
        "-scheme",
        "OpenMirAIeMac",
        "-destination",
        "platform=macOS",
        "-derivedDataPath",
        "build/DerivedData",
        "CODE_SIGNING_ALLOWED=NO",
        "build"
      ],
      "requiredFiles": [
        "OpenMirAIe.xcodeproj/project.pbxproj",
        "OpenMirAIe.xcodeproj/xcshareddata/xcschemes/OpenMirAIeMac.xcscheme"
      ],
      "reason": "Native macOS Xcode project and shared scheme will be added when development starts.",
      "displayName": "openMirAIe"
    }
  ]
}
